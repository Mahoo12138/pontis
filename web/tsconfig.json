{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@/*": ["./src/*"],
      "@pontis/api": ["../packages/api/src/index.ts"],
      "@pontis/api/endpoints/*": ["../packages/api/src/endpoints/*"],
      "@pontis/api/mock/*": ["../packages/api/src/mock/*"],
      "@pontis/i18n": ["../packages/i18n/src/index.ts"]
    }
  },
  "include": ["src", "vite-env.d.ts", "../packages/api/src", "../packages/i18n/src"]
}
