{
  "name": "pontis",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "brand:check": "node scripts/generate-brand-assets.mjs --check",
    "dev": "pnpm --filter @pontis/web dev",
    "dev:extension": "pnpm --filter @pontis/extension dev",
    "dev:test": "sh scripts/test-env.sh",
    "build": "pnpm build:web && pnpm build:extension:zip && pnpm build:server",
    "build:web": "pnpm --filter @pontis/web build",
    "build:extension": "pnpm --filter @pontis/extension build",
    "build:extension:zip": "pnpm --filter @pontis/extension zip",
    "build:server": "node scripts/stage-web-dist.mjs && node scripts/stage-distribution.mjs && cd server && go build -o pontis ./cmd/server",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --no-bail test",
    "test:go": "cd server && go test ./...",
    "test:go:race": "cd server && go test -race ./...",
    "test:fixtures": "cd server && go test -count=1 ./internal/httpapi -run 'TestGolden(Protocol|REST)Fixtures' && pnpm --filter @pontis/protocol test",
    "e2e:dual-profile": "node scripts/e2e-dual-profile.mjs",
    "e2e:api": "node scripts/e2e-api.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "typescript": "^5.7.3"
  }
}
